REDIS_URL=
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_API_KEY=
# Backend base URL, trailing slash required (see lib/apiClient.ts).
NEXT_PUBLIC_URL=http://localhost:8000/
# Browser push public key (customhooks/setupPush.ts). Optional — push setup
# silently no-ops without it. Documented in CLAUDE.md as a known gap that this
# file didn't list it even though the code already reads it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
